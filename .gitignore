# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Arc Studio development instrumentation — never commit runtime logs.
# These files are written by the Arc Studio sandbox and contain local
# browser session data (HMR events, RPC call traces). They are not part
# of the application source and must not be published.
console.jsonl
traces.jsonl

# Environment — may contain private keys or API tokens.
# VITE_NETWORK (the only app env var) is safe to commit if desired,
# but .env files are excluded by default as a safe baseline.
.env
.env.*
!.env.example

# Foundry build artifacts (regenerated by `forge build`)
contracts/out/
contracts/cache/

# Forge snapshot
.gas-snapshot

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Bun lockfile backup
bun.lockb

# TypeScript build info
*.tsbuildinfo
